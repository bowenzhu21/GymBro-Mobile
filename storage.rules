// storage.rules
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && userId == uid();
    }
  }
}